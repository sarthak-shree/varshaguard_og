# These are environment variables. On Vercel add them in Settings > Environment Variables.
# Locally this app does NOT read a .env file: set them in your terminal before starting, e.g.
#   Windows (PowerShell):  $env:GOOGLE_CLIENT_ID="..."; python backend/app.py
#   Mac / Linux:           GOOGLE_CLIENT_ID="..." python backend/app.py

# Random secret that signs login cookies. REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google sign-in: the OAuth "Web application" client ID from Google Cloud Console.
# Looks like 1234567890-abc123.apps.googleusercontent.com (it is public, not a secret).
GOOGLE_CLIENT_ID=

# Hosted Postgres (Neon / Supabase). REQUIRED on Vercel.
# Leave empty locally to use a throwaway SQLite file instead.
DATABASE_URL=
