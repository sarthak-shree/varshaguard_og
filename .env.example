# Copy to ".env" for local development, or add these in Vercel > Settings > Environment Variables.

# Random secret that signs login cookies and hashes one-time codes. REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hosted Postgres (Neon / Supabase). REQUIRED on Vercel.
# Leave empty locally to use a throwaway SQLite file instead.
DATABASE_URL=

# WhatsApp Cloud API. REQUIRED in production.
# Leave empty locally: codes are then printed in the server terminal (dev mode).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=varshaguard_otp
WHATSAPP_TEMPLATE_LANG=en
