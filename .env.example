# Copy to ".env" for local development, or add these in Vercel > Settings > Environment Variables.

# Random secret that signs login cookies. REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google sign-in: the OAuth "Web application" client ID from Google Cloud Console.
# Looks like 1234567890-abc123.apps.googleusercontent.com (it is public, not a secret).
GOOGLE_CLIENT_ID=

# Hosted Postgres (Neon / Supabase). REQUIRED on Vercel.
# Leave empty locally to use a throwaway SQLite file instead.
DATABASE_URL=
